#!/bin/sh /etc/rc.common
# NREPlatform LiteV daemon

USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/nreplatformd
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	procd_send_signal nreplatform
}

service_triggers() {
	procd_add_reload_trigger nreplatform
}

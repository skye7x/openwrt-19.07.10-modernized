# One 'port' section per rule.
#   device     network device (lan1, eth0, br-lan, phy0-ap0, ...)
#   direction  egress  = traffic leaving the router through this port (client download)
#              ingress = traffic entering the router from this port   (client upload)
#              both
#   latency    added delay in ms      (0 = off)
#   jitter     delay variation in ms  (needs latency > 0)
#   loss       packet loss in percent (0 = off)
#   rate       max speed in Mbit/s    (0 = unlimited)

config port
	option enabled '0'
	option device 'lan1'
	option direction 'both'
	option latency '50'
	option jitter '5'
	option loss '1'
	option rate '100'
